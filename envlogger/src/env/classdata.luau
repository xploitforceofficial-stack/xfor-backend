local chainCache: { [string]: { string } } = {}

function ClassData.ancestors(name: string): { string }
	local cached = chainCache[name]
	if cached then
		return cached
	end
	local chain: { string } = { name }
	local seen: { [string]: boolean } = { [name] = true }
	local current = SUPERCLASS[name]
	while current ~= nil and not seen[current] do
		chain[#chain + 1] = current
		seen[current] = true
		current = SUPERCLASS[current]
	end
	if not seen.Instance then
		chain[#chain + 1] = "Instance"
	end
	chainCache[name] = chain
	return chain
end

function ClassData.isA(selfClass: string, asked: string): boolean
	if asked == selfClass or asked == "Instance" then
		return true
	end
	if asked == nil or asked == "" then
		return false
	end
	local chain = ClassData.ancestors(selfClass)
	for _, base in ipairs(chain) do
		if base == asked then
			return true
		end
	end
	return false
end

function ClassData.isCreatable(name: string): boolean
	return CREATABLE[name] == true
end

function ClassData.isService(name: string): boolean
	return SERVICE[name] == true
end

function ClassData.isKnown(name: string): boolean
	return ALL[name] == true
end

function ClassData.propertyType(className: string, propName: string): string?
	local entry = PROPERTY_TYPES[className]
	if entry == nil then
		return nil
	end
	return entry[propName]
end

function ClassData.creatableNames(): { string }
	local names: { string } = {}
	for name in pairs(CREATABLE) do
		names[#names + 1] = name
	end
	table.sort(names)
	return names
end

return ClassData
