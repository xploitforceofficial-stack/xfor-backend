	},
}

function PropDefaults.materialize(): { [string]: { [string]: any } }
	local resolve = RESOLVE
	local out: { [string]: { [string]: any } } = {}
	for className, props in pairs(DEFAULTS) do
		local built: { [string]: any } = {}
		for propName, descriptor in pairs(props) do
			if type(descriptor) == "table" and type(descriptor.c) == "string" then
				local ok, value = pcall(resolve, descriptor.c, descriptor.a)
				built[propName] = if ok then value else nil
			else
				built[propName] = descriptor
			end
		end
		out[className] = built
	end
	return out
end

function PropDefaults.count(): number
	local n = 0
	for _ in pairs(DEFAULTS) do n += 1 end
	return n
end

return PropDefaults
