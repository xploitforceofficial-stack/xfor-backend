local D = require("../src/env/datatypes")
local out = D.build()
print("Random:", tostring(out.Random))
local r = out.Random.new(1)
print("next:", r:NextNumber())
print("int:", r:NextInteger(1, 100))
local c = r:Clone()
print("clone lockstep:", c:NextNumber() == r:NextNumber())
print("unseeded a:", out.Random.new():NextNumber())
print("unseeded b:", out.Random.new():NextNumber())
